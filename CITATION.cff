    given-names: "Julio César"
    affiliation: "Universidad del Valle"
  - family-names: "Londoño Vélez"
    given-names: "Julián Esteban"
    affiliation: "Universidad del Valle"
repository-code: "https://github.com/julianlondon-uv/precio_spot"
license: MIT
date-released: 2026-11-25
keywords:
  - electricity price forecasting
  - time series
  - Colombia
  - energy market
  - SARIMAX
  - XGBoost
  - LSTM
  - GRU
  - deep learning
  - reproducible research
